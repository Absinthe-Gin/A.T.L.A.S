# Copy this file to `.env`. Values prefixed with VITE_ are embedded in the
# browser bundle, so never put secrets here.

# Base URL of the backend API, including the version prefix.
VITE_API_BASE_URL=http://127.0.0.1:8710/api/v1

# Port of the dev server. If you change it, also update CORS_ALLOWED_ORIGINS
# in backend/.env.
VITE_DEV_SERVER_PORT=5710

# Optional. Map tiles for Leaflet. Default: OpenStreetMap's public tile server,
# which allows light personal use with attribution.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# Used automatically when the tiles above fail to load (e.g. openstreetmap.org blocked).
# Default: the openstreetmap.de community server (same OpenStreetMap data).
# VITE_MAP_FALLBACK_TILE_URL=https://tile.openstreetmap.de/{z}/{x}/{y}.png
