# Copy this file to `.env` and adjust the values. Never commit `.env`.

# development | testing | production
APP_ENV=development

# SQLAlchemy async URL. The directory of a SQLite file is created automatically.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Comma-separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# console | json
LOG_FORMAT=console
