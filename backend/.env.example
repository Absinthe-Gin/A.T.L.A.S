# Copy this file to `.env` and adjust the values. Never commit `.env`.

# development | testing | production
APP_ENV=development

# Address the server listens on when started with `uv run python -m app`.
API_HOST=127.0.0.1
API_PORT=8710

# SQLAlchemy async URL. The directory of a SQLite file is created automatically.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Comma-separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5710,http://127.0.0.1:5710

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# console | json
LOG_FORMAT=console

# --- AI ---
# ollama | mock  (mock needs no external service and returns a fixed reply)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Name of a model already pulled into Ollama that supports tool calling.
# Leave empty to start without chat; the chat endpoint then reports `llm_not_configured`.
OLLAMA_MODEL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
AI_MAX_TOOL_ITERATIONS=5
AI_TOOL_TIMEOUT_SECONDS=15
AI_CONTEXT_MAX_MESSAGES=20
AI_MEMORY_LIMIT=5

# --- External data services ---
# Free services that need no key: OpenStreetMap Nominatim (places), Open-Meteo
# (weather) and OSRM (road distance). Keep the defaults unless you self-host.
EXTERNAL_TIMEOUT_SECONDS=10
# Optional contact (e-mail or URL) added to the User-Agent, as the OpenStreetMap
# usage policy asks for identifiable clients.
OSM_CONTACT=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OSRM_BASE_URL=https://router.project-osrm.org
# Flight prices from Google Flights via SerpApi (https://serpapi.com, free plan
# with a monthly limit). Leave empty to show a Google Flights link instead.
# Photon (OpenStreetMap data on another host): restaurant search first, and place
# search when Nominatim fails or openstreetmap.org is blocked on the network.
PHOTON_BASE_URL=https://photon.komoot.io
# Restaurant search by dish (OpenStreetMap data through the Overpass API).
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=30
SERPAPI_BASE_URL=https://serpapi.com
SERPAPI_API_KEY=
